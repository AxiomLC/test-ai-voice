# Copy to .env and fill in. Run: npm start  (Node 20.6+)
PORT=4400

# --- LLM (DeepInfra, OpenAI-compatible) ---
DEEPINFRA_API_KEY=
# Set the exact model id from deepinfra.com/models (the GLM Flash one you use)
DEEPINFRA_MODEL=
DEEPINFRA_URL=https://api.deepinfra.com/v1/openai/chat/completions
SYSTEM_PROMPT=You are a voice assistant. Reply in 1-3 short spoken sentences. No markdown, no lists, no emoji.
MAX_TOKENS=300

# --- TTS engines (local servers; adjust to how you run them) ---
# Kokoro-FastAPI (OpenAI-compatible) default port 8880
KOKORO_URL=http://localhost:8880/v1/audio/speech
KOKORO_VOICE=af_heart
# Pocket TTS (`pocket-tts serve`) default port 8000
POCKET_URL=http://localhost:8000/tts
POCKET_VOICE=alba
# Piper (`python -m piper.http_server -m <voice>`) default port 5000
PIPER_URL=http://localhost:5000/

# --- Optional: ONE launching point. Commands run when this server starts (leave blank if already running) ---
KOKORO_CMD=
POCKET_CMD=
PIPER_CMD=
